# ==============================================================================
# MariageFacile / Wedding AI Builder — Variables d'environnement (.env.example)
# Copiez ce fichier vers .env.local et renseignez vos propres clés et identifiants.
# ==============================================================================

# ==========================================
# 1. APPLICATION & SÉCURITÉ (Obligatoire)
# ==========================================
# URL racine de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé secrète pour signer les jetons de session JWT (au moins 32 caractères aléatoires)
# Ex: openssl rand -base64 32
JWT_SECRET=changez_ce_secret_pour_une_chaine_aleatoire_de_32_caracteres_min

# Mot de passe administrateur par défaut pour l'accès aux interfaces /admin
ADMIN_PASSWORD=admin1234

# Mode de base de données :
# "false" = utilise Firebase Firestore & Admin (recommandé en production)
# "true"  = utilise le stockage local (fichiers JSON en mémoire/disque pour le dev sans Firebase)
USE_LOCAL_DB=false


# ==========================================
# 2. INTELLIGENCE ARTIFICIELLE (OpenAI)
# ==========================================
# Clé API OpenAI (génération de plannings, quiz IA, matching prestataires)
OPENAI_API_KEY=votre_cle_api_openai_ici

# Modèle OpenAI utilisé par défaut
OPENAI_MODEL=gpt-4o-mini


# ==========================================
# 3. FIREBASE CLIENT (SDK Web)
# ==========================================
# Créer un projet sur https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=votre-projet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456


# ==========================================
# 4. FIREBASE ADMIN (SDK Serveur)
# ==========================================
# Généré dans Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com
# Attention : la clé privée doit être entre guillemets et conserver les \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----\n"


# ==========================================
# 5. EMAILS & NOTIFICATIONS (SMTP Universel)
# ==========================================
# Compatible avec TOUT serveur SMTP : Brevo, Mailjet, Postmark, AWS SES, OVH, Gmail, Maildev, etc.

# --- Pour le développement local avec Maildev (port 1025, sans mot de passe) : ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_NAME="MariageFacile"
SMTP_FROM_EMAIL=hello@mariagefacile.fr

# --- Pour la Production (Exemple Brevo / Sendinblue) : ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre-email@domaine.com
# SMTP_PASSWORD=votre-cle-smtp-master
# SMTP_SECURE=false
# SMTP_FROM_NAME="MariageFacile"
# SMTP_FROM_EMAIL=contact@votredomaine.fr

# --- Pour la Production (Exemple Gmail / Google Workspace) : ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre-adresse@gmail.com
# SMTP_PASSWORD=mot-de-passe-d-application-16-lettres
# SMTP_FROM_NAME="MariageFacile"
# SMTP_FROM_EMAIL=votre-adresse@gmail.com

# (Optionnel) Service d'email Resend de fallback si utilisé
RESEND_API_KEY=votre_cle_resend_ici
RESEND_FROM_EMAIL="MariageFacile <hello@mariagefacile.fr>"


# ==========================================
# 6. PAIEMENTS & ABONNEMENTS (Stripe)
# ==========================================
# Clés API Stripe récupérables sur https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=votre_cle_publique_stripe_ici
STRIPE_SECRET_KEY=votre_cle_secrete_stripe_ici
STRIPE_WEBHOOK_SECRET=votre_webhook_secret_stripe_ici

# ID des tarifs récurrents / plans prestataires (créés dans le dashboard Stripe)
STRIPE_PRICE_ID=price_votre_tarif_standard
STRIPE_PRICE_ESSENTIAL_ID=price_votre_tarif_essentiel
STRIPE_PRICE_PREMIUM_ID=price_votre_tarif_premium
STRIPE_PRICE_ELITE_ID=price_votre_tarif_elite


# ==========================================
# 7. STOCKAGE D'IMAGES & MÉDIAS (Cloudinary)
# ==========================================
# Permet l'upload des photos de portfolio, devis, avatars, et justificatifs
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=votre_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=votre_unsigned_preset


# ==========================================
# 8. CACHE IA & SESSIONS (Redis - Optionnel)
# ==========================================
# Utilisé pour la mise en cache rapide des réponses IA et limitation de débit (rate limiting)
REDIS_URL=redis://localhost:6379


# ==========================================
# 9. ANALYTICS & TÉLÉMÉTRIE (PostHog - Optionnel)
# ==========================================
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ==========================================
# 10. SUPABASE (Optionnel / Magic Link Auth)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ==========================================
# 11. GOOGLE BUSINESS & MAPS (Optionnel)
# ==========================================
# Permet l'appel réel à l'API Google Places pour la recherche et l'import direct des avis en production.
# Si non renseignée, un environnement sandbox certifié haute fidélité est automatiquement actif (développement & tests sans frais).
GOOGLE_PLACES_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

