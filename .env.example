# Variables critiques (l'application refuse de démarrer si elles sont absentes)
JWT_SECRET=change-moi-par-une-chaine-de-32-caracteres-min

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin (requis si USE_LOCAL_DB=false)
FIREBASE_PROJECT_ID=...
FIREBASE_CLIENT_EMAIL=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mode local (true pour contourner Firebase)
USE_LOCAL_DB=false

# Redis (optionnel)
REDIS_URL=redis://localhost:6379

# Emails (optionnel)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="MariageFacile <hello@mariagefacile.fr>"

# Stripe
STRIPE_SECRET_KEY=sk_test_...
# Price ID legacy (fallback pour le plan Essentiel)
STRIPE_PRICE_ID=price_...
STRIPE_PRICE_ESSENTIAL_ID=price_...
STRIPE_PRICE_PREMIUM_ID=price_...
STRIPE_PRICE_ELITE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudinary (client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=...

# PostHog (client)
NEXT_PUBLIC_POSTHOG_KEY=...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
